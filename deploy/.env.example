# Copiar a deploy/.env (no versionado) y completar. Las llaves deben ser LAS MISMAS del entorno
# de Vercel que se reemplaza (ver .env.production.local / .env.qa.local en la raíz del repo).

# --- Dominio (DNS tipo A apuntando a la IP de la VPS) ---
APP_DOMAIN=oilowl.example.com
ALLOWED_HOSTS=oilowl.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://oilowl.example.com

# --- Supabase (pooler IPv4; la conexión directa db.<ref>.supabase.co es solo IPv6) ---
# Modo transacción (6543), igual que en Vercel. Con el modo sesión (5432) puede subir DB_CONN_MAX_AGE a 60.
DATABASE_URL=postgres://postgres.<project_ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DB_CONN_MAX_AGE=0
# Opcional: por defecto `migrate` usa DATABASE_URL cambiando :6543 por :5432.
# DATABASE_URL_MIGRATIONS=

# --- Llaves: copiar tal cual, NUNCA regenerar ---
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
FIELD_ENCRYPTION_KEYS=
HASH_CHAIN_KEY=
CRON_SECRET=

# --- Opcionales ---
# GUNICORN_WORKERS=3
# LOG_LEVEL=INFO
# CACHE_URL=redis://redis:6379/0
